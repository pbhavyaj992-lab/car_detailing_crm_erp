# Public — safe for browser bundle (Vite replaces at build time)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only — used by TanStack server functions & SSR (never bundled to browser)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only, privileged. Required only by the platform-admin server functions.
# The MY_ prefix is deliberate: Vercel's Supabase integration owns the
# unprefixed SUPABASE_SERVICE_ROLE_KEY name and would overwrite it.
MY_SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx     # NEVER expose to the client

# Optional — Lovable AI Gateway (used for AI features only)
LOVABLE_API_KEY=

# Not used by the app — do not set SUPABASE_PROJECT_ID / VITE_SUPABASE_PROJECT_ID
